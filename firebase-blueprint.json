{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user account profile containing PII such as email and phone number.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "upiId": { "type": "string", "maxLength": 100 },
        "photoUrl": { "type": "string", "maxLength": 250000 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9_]+$" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "preferredCurrency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "THB"] },
        "customTags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "handle", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly accessible friend/co-member display metadata without private PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9_]+$" },
        "photoUrl": { "type": "string", "maxLength": 250000 },
        "upiId": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "handle", "createdAt", "updatedAt"]
    },
    "UserLookup": {
      "title": "UserLookup",
      "description": "Exact-match lookup record keyed by normalized email or handle for friend discovery.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 250000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "handle", "createdAt", "updatedAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Bidirectional friendship connection between two registered users.",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "requesterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "nicknames": { "type": "object" },
        "notes": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["users", "requesterUid", "recipientUid", "status", "createdAt", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request between two users with sender/recipient validation and atomic acceptance into friendships.",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "senderDisplayName": { "type": "string", "maxLength": 80 },
        "senderPhotoUrl": { "type": "string", "maxLength": 250000 },
        "recipientUsername": { "type": "string", "minLength": 2, "maxLength": 40 },
        "recipientDisplayName": { "type": "string", "maxLength": 80 },
        "recipientPhotoUrl": { "type": "string", "maxLength": 250000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["users", "senderId", "recipientId", "senderUsername", "recipientUsername", "status", "createdAt", "updatedAt"]
    },
    "FriendInvite": {
      "title": "FriendInvite",
      "description": "Shareable friend invitation token with expiry and usage limit.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 6, "maxLength": 128 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxUses": { "type": "integer" },
        "usesCount": { "type": "integer" },
        "usedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "creatorUid", "creatorName", "expiresAt", "maxUses", "usesCount", "usedBy", "createdAt", "updatedAt"]
    },
    "Group": {
      "title": "Group",
      "description": "Shared expense group where all active members have equal permissions.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "coverImage": { "type": "string", "maxLength": 350000 },
        "currency": { "type": "string", "enum": ["INR"] },
        "isArchived": { "type": "boolean" },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "memberUids": { "type": "array" },
        "memberNames": { "type": "object" },
        "memberEmails": { "type": "object" },
        "memberJoinedAt": { "type": "object" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "currency", "isArchived", "memberUids", "memberNames", "createdBy", "createdAt", "updatedAt"]
    },
    "GroupInvite": {
      "title": "GroupInvite",
      "description": "Shareable group invitation token with expiration, revocation state, and usage caps.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 6, "maxLength": 128 },
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "revokedBy": { "type": "string", "maxLength": 128 },
        "revokedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxUses": { "type": "integer" },
        "usesCount": { "type": "integer" },
        "usedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "groupId", "groupName", "createdBy", "expiresAt", "maxUses", "usesCount", "usedBy", "createdAt", "updatedAt"]
    },
    "GroupEmailInvite": {
      "title": "GroupEmailInvite",
      "description": "Tracked group invitation issued to a recipient email address.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "emailLower": { "type": "string", "minLength": 3, "maxLength": 120 },
        "inviteToken": { "type": "string", "minLength": 6, "maxLength": 128 },
        "inviteUrl": { "type": "string", "minLength": 1, "maxLength": 300 },
        "existingUserUid": { "type": "string", "maxLength": 128 },
        "existingUserName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "accepted", "cancelled"] },
        "deliveryStatus": { "type": "string", "enum": ["sent", "provider_unconfigured", "failed"] },
        "deliveryNote": { "type": "string", "maxLength": 240 },
        "invitedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "invitedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "groupName", "email", "emailLower", "inviteToken", "inviteUrl", "status", "deliveryStatus", "invitedByUid", "invitedByName", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Group or trip expense with integer paise splitting, multi-payer support, Firebase Storage receipt metadata, and recurring rule links.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tripId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "amountPaise": { "type": "integer" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "THB"] },
        "originalAmountMinor": { "type": "integer" },
        "exchangeRateToInr": { "type": "number" },
        "tags": { "type": "array" },
        "category": {
          "type": "string",
          "enum": [
            "Food & Drinks", "Transport", "Accommodation", "Shopping",
            "Entertainment", "Groceries", "Bills", "Travel", "Other",
            "Food", "Restaurant", "Hotel", "Clubbing", "Fuel", "Tickets"
          ]
        },
        "expenseDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "splitMethod": { "type": "string", "enum": ["equal", "unequal", "percentage", "shares"] },
        "payers": { "type": "array" },
        "shares": { "type": "array" },
        "participantUids": { "type": "array" },
        "payerUids": { "type": "array" },
        "receiptImage": { "type": "string", "maxLength": 450000 },
        "receiptMetadata": { "type": "object" },
        "isRecurring": { "type": "boolean" },
        "recurringFrequency": { "type": "string", "enum": ["none", "daily", "weekly", "monthly", "yearly", "custom"] },
        "recurringIntervalDays": { "type": "integer" },
        "nextOccurrenceDate": { "type": "string", "maxLength": 40 },
        "recurringRuleId": { "type": "string", "maxLength": 128 },
        "occurrenceKey": { "type": "string", "maxLength": 160 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "title", "amountPaise", "category", "expenseDate", "splitMethod", "payers", "shares", "participantUids", "payerUids", "isRecurring", "recurringFrequency", "createdBy", "updatedBy", "createdAt", "updatedAt"]
    },
    "RecurringExpenseRule": {
      "title": "RecurringExpenseRule",
      "description": "Recurring expense schedule rule processed automatically by Firebase Cloud Functions.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "amountPaise": { "type": "integer" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "THB"] },
        "originalAmountMinor": { "type": "integer" },
        "exchangeRateToInr": { "type": "number" },
        "tags": { "type": "array" },
        "category": {
          "type": "string",
          "enum": [
            "Food & Drinks", "Transport", "Accommodation", "Shopping",
            "Entertainment", "Groceries", "Bills", "Travel", "Other",
            "Food", "Restaurant", "Hotel", "Clubbing", "Fuel", "Tickets"
          ]
        },
        "splitMethod": { "type": "string", "enum": ["equal", "unequal", "percentage", "shares"] },
        "payers": { "type": "array" },
        "shares": { "type": "array" },
        "participantUids": { "type": "array" },
        "payerUids": { "type": "array" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "custom"] },
        "intervalDays": { "type": "integer" },
        "anchorDayOfMonth": { "type": "integer" },
        "monthEndPolicy": { "type": "string", "enum": ["clamp_last_day"] },
        "startDate": { "type": "string", "minLength": 10, "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "nextOccurrenceDate": { "type": "string", "minLength": 10, "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "paused", "cancelled", "completed"] },
        "generatedCount": { "type": "integer" },
        "lastGeneratedDate": { "type": "string", "maxLength": 20 },
        "lastGeneratedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "title", "amountPaise", "category", "splitMethod", "payers", "shares", "participantUids", "payerUids", "frequency", "intervalDays", "anchorDayOfMonth", "monthEndPolicy", "startDate", "nextOccurrenceDate", "status", "generatedCount", "createdBy", "updatedBy", "createdAt", "updatedAt"]
    },
    "Trip": {
      "title": "Trip",
      "description": "Shared travel trip ledger with budgets, destination, equal participant permissions, and optional individual member budgets.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "destination": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "coverImage": { "type": "string", "maxLength": 350000 },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "AED", "SGD", "THB"] },
        "exchangeRateToInr": { "type": "number" },
        "exchangeRateUpdatedAt": { "type": "string", "maxLength": 40 },
        "budgetPaise": { "type": "integer" },
        "memberBudgetsPaise": { "type": "object" },
        "isArchived": { "type": "boolean" },
        "participantUids": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantEmails": { "type": "object" },
        "participantJoinedAt": { "type": "object" },
        "lastJoinToken": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "destination", "description", "currency", "exchangeRateToInr", "budgetPaise", "isArchived", "participantUids", "participantNames", "createdBy", "createdAt", "updatedAt"]
    },
    "TripInvite": {
      "title": "TripInvite",
      "description": "Shareable trip invitation token with expiration, revocation state, and usage caps.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 6, "maxLength": 128 },
        "tripId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tripName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "destination": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "revokedBy": { "type": "string", "maxLength": 128 },
        "revokedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maxUses": { "type": "integer" },
        "usesCount": { "type": "integer" },
        "usedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "tripId", "tripName", "createdBy", "expiresAt", "maxUses", "usesCount", "usedBy", "createdAt", "updatedAt"]
    },
    "ExpenseNote": {
      "title": "ExpenseNote",
      "description": "Discussion note attached to an expense.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "text", "createdAt"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "External payment settlement record with confirmation workflow.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amountPaise": { "type": "integer" },
        "method": { "type": "string", "enum": ["cash", "upi"] },
        "upiTransactionRef": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 250 },
        "status": { "type": "string", "enum": ["pending", "awaiting_confirmation", "confirmed", "disputed"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confirmedBy": { "type": "string", "maxLength": 128 },
        "disputeReason": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "fromUid", "fromName", "toUid", "toName", "amountPaise", "method", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "GroupActivity": {
      "title": "GroupActivity",
      "description": "Audit log entry of actions inside a group or trip.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "actorUid", "actorName", "type", "summary", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time user notification record.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 300 },
        "link": { "type": "string", "maxLength": 200 },
        "groupId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "senderUid", "senderName", "type", "title", "body", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private user profile isolated to the owner."
    },
    "/publicProfiles/{uid}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public display profile for friends and group members."
    },
    "/userLookup/{lookupKey}": {
      "schema": { "$ref": "#/entities/UserLookup" },
      "description": "Exact-key lookup for finding registered users by email or handle."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Accepted friendship links and legacy connections."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending, accepted, rejected, and cancelled friend requests keyed deterministically by sorted UIDs."
    },
    "/friendInvites/{token}": {
      "schema": { "$ref": "#/entities/FriendInvite" },
      "description": "Shareable friend invite links."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Shared expense groups."
    },
    "/groupInvites/{token}": {
      "schema": { "$ref": "#/entities/GroupInvite" },
      "description": "Shareable group invitation tokens."
    },
    "/groups/{groupId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Expenses within a group."
    },
    "/groups/{groupId}/expenses/{expenseId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/ExpenseNote" },
      "description": "Discussion notes on an expense."
    },
    "/groups/{groupId}/recurringExpenses/{ruleId}": {
      "schema": { "$ref": "#/entities/RecurringExpenseRule" },
      "description": "Recurring expense rules within a group."
    },
    "/groups/{groupId}/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "Payment settlement records within a group."
    },
    "/groups/{groupId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/GroupActivity" },
      "description": "Activity log entries within a group."
    },
    "/groups/{groupId}/invites/{token}": {
      "schema": { "$ref": "#/entities/GroupInvite" },
      "description": "Group-scoped mirror of invitation links visible to all equal-permission members."
    },
    "/groups/{groupId}/emailInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/GroupEmailInvite" },
      "description": "Tracked email invitations within a group."
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Shared travel trips with destination, dates, overall budget, and equal participant permissions."
    },
    "/tripInvites/{token}": {
      "schema": { "$ref": "#/entities/TripInvite" },
      "description": "Shareable trip invitation tokens."
    },
    "/trips/{tripId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Expenses within a trip."
    },
    "/trips/{tripId}/expenses/{expenseId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/ExpenseNote" },
      "description": "Discussion notes on a trip expense."
    },
    "/trips/{tripId}/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "Payment settlement records within a trip."
    },
    "/trips/{tripId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/GroupActivity" },
      "description": "Activity log entries within a trip."
    },
    "/trips/{tripId}/invites/{token}": {
      "schema": { "$ref": "#/entities/TripInvite" },
      "description": "Trip-scoped mirror of invitation links visible to all equal-permission trip participants."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    }
  }
}
